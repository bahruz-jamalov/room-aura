{
  "name": "room-aura",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:tourist": "pnpm --filter @room-aura/tourist dev",
    "dev:admin": "pnpm --filter @room-aura/admin dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:test": "supabase test db",
    "seed": "tsx scripts/seed.ts",
    "test:isolation": "tsx scripts/test-isolation.ts",
    "test:anon-access": "tsx scripts/test-anon-access.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
