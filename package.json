{
  "name": "room-aura",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:tourist": "pnpm --filter @room-aura/tourist dev",
    "dev:admin": "pnpm --filter @room-aura/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:test": "supabase test db",
    "seed": "tsx scripts/seed.ts",
    "test:isolation": "tsx scripts/test-isolation.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
